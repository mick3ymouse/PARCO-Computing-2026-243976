#!/bin/bash
#PBS -N spmv_ghost_test
#PBS -l select=1:ncpus=4:mpiprocs=4:mem=4gb
#PBS -l walltime=00:05:00
#PBS -q shortCPUQ
#PBS -o logs/test/weak_test.log
#PBS -e logs/test/weak_test.err

echo "=========================================="
echo "  SpMV: Ghost Cell & Correctness Test Weak"
echo "=========================================="

# 1. SETUP AMBIENTE
echo ">>> Setting up environment..."
module purge
module load gompi/2023a
module load Python/3.11.3-GCCcore-12.3.0

# Verifica compilatore
which mpic++

# 2. COMPILAZIONE MANUALE (Per evitare modifiche a CMakeLists.txt)
cd $PBS_O_WORKDIR

echo ">>> Compiling main_test_weak.cpp manually..."

mkdir -p build

# Compiliamo direttamente main_ghost_test insieme alle dipendenze (Utils e SparseMatrix)
# -Isrc : include la cartella src per gli header
# -std=c++17 : standard C++ recente
mpic++ -std=c++17 -O3 -march=native -Isrc \
       src/main_test_weak.cpp \
       src/Utils.cpp \
       src/SparseMatrix.cpp \
       -o build/spmv_weak_test_exec

if [ ! -f ./build/spmv_weak_test_exec ]; then
    echo "ERROR: Compilation failed!"
    exit 1
fi

echo ">>> Compilation Successful."
echo ""

# 3. ESECUZIONE TEST
echo ">>> Running Correctness Test..."

mpirun -np 4 ./build/spmv_weak_test_exec
           
# Verifica se C++ ha girato
if [ $? -ne 0 ]; then
    echo "ERROR: MPI Execution failed / Crashed"
    exit 1
fi

echo ">>> C++ part finished. Files generated."
echo ""

# 4. VERIFICA PYTHON (Controllo Matematico)
echo ">>> Running Python Verification..."

# Assicurati che lo script python sia dove dici che sia
if [ -f "scripts/verify_weak.py" ]; then
    source .venv/bin/activate
    python3 scripts/verify_weak.py
else
    echo "WARNING: scripts/verify_weak.py not found! Run manually."
fi

echo ""
echo "=========================================="
echo "  TEST COMPLETE"
echo "=========================================="