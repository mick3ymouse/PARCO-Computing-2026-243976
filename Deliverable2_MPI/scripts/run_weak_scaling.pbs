#!/bin/bash
#PBS -N spmv_weak
#PBS -l select=2:ncpus=96:mpiprocs=96:mem=32gb
#PBS -l walltime=02:00:00
#PBS -q shortCPUQ
#PBS -o logs/weak_scaling/weak_scaling.log
#PBS -e logs/weak_scaling/weak_scaling.err

# --- EMAIL NOTIFICATIONS (Uncomment to enable) ---
# #PBS -m abe
# #PBS -M your_email@domain.com
# -------------------------------------------------

echo "=========================================="
echo "  SpMV: Weak Scaling Benchmark"
echo "=========================================="

# ======================================
# LOAD MODULES
# ======================================

echo ">>> Loading required modules..."

MODULES_TO_LOAD=("gompi/2023a")

# Check and load each module
for module_name in "${MODULES_TO_LOAD[@]}"; do
    if ! module list 2>&1 | grep -q "$module_name"; then
        echo "    Loading $module_name..."
        module load "$module_name"
        
        if [ $? -ne 0 ]; then
            echo "    ERROR: Failed to load $module_name."
            exit 1
        fi
    else
        echo "    $module_name is already loaded."
    fi
done

echo ">>> Modules loaded successfully."

# ======================================
# MAIN SCRIPT
# ======================================

# Move to the directory where the script was submitted
cd $PBS_O_WORKDIR

# Start Weak Scaling Test
echo ">>> Starting Weak Scaling Tests..."
echo ""

# Define the benchmark results file
BENCH_FILE="results/weak_scaling.csv"
mkdir -p results
echo "   Saving results to: $BENCH_FILE"
echo ""

# Weak Scaling Parameters
BASE_ROWS=100000   # Each core will always have 100k rows
NNZ_ROW=50         # Fixed density

# Execute weak scaling tests for different process counts
for P in 1 2 4 8 16 32 64 128; do
    echo ">> Running with $P processes..."
    
    # Mpirun will calculate the global size = BASE_ROWS * P
    mpirun  --hostfile $PBS_NODEFILE \
            --oversubscribe \
            -map-by ppr:64:node --bind-to core \
            -np $P \
            build/spmv_weak_exec $BASE_ROWS $NNZ_ROW "$BENCH_FILE"
done

echo ""
echo ">>> Weak Scaling Tests completed."

# ======================================
# SUMMARY GENERATION
# ======================================
echo ""
echo "=========================================="
echo "  Benchmark Weak Scaling Complete!"
echo "=========================================="
echo "End time: $(date)"
echo "Results saved to: $BENCH_FILE"
echo ""
echo ">>> Generating system summary..."

LSCPU_OUTPUT=$(lscpu 2>/dev/null)
FREE_OUTPUT=$(free -h 2>/dev/null)
OS_VERSION=$(grep -E '^(NAME|VERSION)=' /etc/os-release | cut -d'"' -f2 | paste -sd " " -)
KERNEL_VERSION=$(uname -r)

# Helper function to parse system info
parse_cpu() {
    echo "$LSCPU_OUTPUT" | grep -i "$1" | awk -F ':' '{print $2}' | sed 's/^[ \t]*//' | head -n 1
}

# Find active network interface (excluding loopback)
ACTIVE_IF=$(ip -o link show up | grep -v "lo" | awk -F': ' '{print $2}' | head -n 1)

if [ -n "$ACTIVE_IF" ]; then
    # Get Link Speed (Gbps)
    RAW_SPEED=$(cat /sys/class/net/$ACTIVE_IF/speed 2>/dev/null)
    if [ -n "$RAW_SPEED" ] && [ "$RAW_SPEED" -ge 0 ]; then
        NET_SPEED="$((RAW_SPEED / 1000)) Gbps"
    else
        NET_SPEED="Unknown"
    fi
    
    # Identify Hardware Model via PCI ID
    PCI_BUS_ID=$(basename $(readlink /sys/class/net/$ACTIVE_IF/device) 2>/dev/null)

    if [ -n "$PCI_BUS_ID" ]; then
        # Query specific PCI slot info
        NET_MODEL=$(/sbin/lspci -s $PCI_BUS_ID 2>/dev/null | cut -d: -f3- | sed 's/^[ \t]*//')
    else
        NET_MODEL="Unknown (Non-PCI Interface)"
    fi
    
    # Check RDMA Status
    if command -v ibv_devinfo &> /dev/null; then
       if ibv_devinfo | grep -q "PORT_ACTIVE"; then
           RDMA_STATUS="Available (Active)"
       else
           RDMA_STATUS="Inactive (Link Down)"
       fi
    else
       RDMA_STATUS="Not Detected"
    fi
else
    ACTIVE_IF="None"
    NET_SPEED="N/A"
    NET_MODEL="Unknown"
    RDMA_STATUS="N/A"
fi

# Crearte summary file
SUMMARY_FILE="logs/weak_scaling/weak_scaling_summary.txt"
{
    echo "============================================================"
    echo "  HPC BENCHMARK - SYSTEM & EXECUTION SUMMARY"
    echo "============================================================"
    echo "Date:             $(date)"
    echo "Hostname:         $(hostname)"
    echo "OS / Kernel:      $OS_VERSION ($KERNEL_VERSION)"
    echo ""
    echo "------------------------------------------------------------"
    echo "  COMPUTING RESOURCES (CPU/RAM)"
    echo "------------------------------------------------------------"
    echo "CPU Model:        $(parse_cpu "Model name")"
    echo "Architecture:     $(parse_cpu "Architecture")"
    echo "Total Sockets:    $(parse_cpu "^Socket(s):")"
    echo "Cores per Socket: $(parse_cpu "^Core(s) per socket:")"
    echo "Total Phys Cores: $(parse_cpu "^CPU(s):")"
    echo "L3 Cache:         $(parse_cpu "L3 cache")"
    echo "Total Memory:     $(echo "$FREE_OUTPUT" | grep 'Mem:' | awk '{print $2}')"
    echo ""
    echo "------------------------------------------------------------"
    echo "  INTERCONNECT TOPOLOGY (NETWORK)"
    echo "------------------------------------------------------------"
    echo "Active Interface: $ACTIVE_IF"
    echo "Link Speed:       $NET_SPEED"
    echo "Adapter Model:    $NET_MODEL"
    echo "Transport Proto:  $RDMA_STATUS"
    echo "Jumbo Frames:     $(ip link show $ACTIVE_IF | grep -o 'mtu [0-9]*' | awk '{print $2}')"
    echo ""
    echo "------------------------------------------------------------"
    echo "  SOFTWARE ENVIRONMENT"
    echo "------------------------------------------------------------"
    echo "GCC Version:      $(gcc --version | head -n 1)"
    echo "MPI Version:      $(mpirun --version | head -n 1)"
    echo ""
    echo "------------------------------------------------------------"
    echo "  OUTPUT FILES"
    echo "------------------------------------------------------------"
    echo "Data:             $BENCH_FILE"     
} > "$SUMMARY_FILE"

echo ">>> Summary saved to: $SUMMARY_FILE"