#!/bin/bash
#PBS -N spmv
#PBS -l select=4:ncpus=64:mpiprocs=64:mem=32gb
#PBS -l walltime=02:00:00
#PBS -q shortCPUQ
#PBS -o logs/strong_scaling/strong_scaling.log
#PBS -e logs/strong_scaling/strong_scaling.err

# --- EMAIL NOTIFICATIONS (Uncomment to enable) ---
# #PBS -m abe
# #PBS -M michimar2003@outlook.com
# -------------------------------------------------

echo "=========================================="
echo "  SpMV: Strong Scaling Benchmark"
echo "=========================================="

# ======================================
# LOAD MODULES
# ======================================

echo ">>> Loading required modules..."

MODULES_TO_LOAD=("gompi/2023a")

# Check and load each module
for module_name in "${MODULES_TO_LOAD[@]}"; do
    if ! module list 2>&1 | grep -q "$module_name"; then
        echo "    Loading $module_name..."
        module load "$module_name"
        
        if [ $? -ne 0 ]; then
            echo "    ERROR: Failed to load $module_name."
            exit 1
        fi
    else
        echo "    $module_name is already loaded."
    fi
done

echo ">>> Modules loaded successfully."

# ======================================
# MAIN SCRIPT
# ======================================

# Move to the directory where the script was submitted
cd $PBS_O_WORKDIR

# Start Strong Scaling Test
echo ">>> Starting Strong Scaling Tests..."

# Define the benchmark results file
BENCH_FILE="results/strong_scaling.csv"
mkdir -p results
rm -f $BENCH_FILE
echo "   Saving results to: $BENCH_FILE"
echo ""

# Define the root folder containing all matrix subdirectories
MATRICES_ROOT="$PBS_O_WORKDIR/matrices"

# Check if the directory exists
if [ ! -d "$MATRICES_ROOT" ]; then
    echo "Error: Directory $MATRICES_ROOT not found!"
    exit 1
fi

echo ">>> Looking for matrices in: $MATRICES_ROOT..."
echo ""

# OUTER LOOP: Iterate over every item inside the matrices folder
for matrix_path in "$MATRICES_ROOT"/*; do
    
    # Check if the current item is actually a directory (ignore files like .txt, .py)
    if [ -d "$matrix_path" ]; then
        
        # Extract the folder name (e.g., "494_bus_bin") for cleaner logging
        matrix_name=$(basename "$matrix_path")
        
        echo "==================================================="
        echo " PROCESSING MATRIX: $matrix_name"
        echo " Path: $matrix_path"
        echo "==================================================="

        # INNER LOOP: Perform Strong Scaling for the current matrix
        # We run with 1, 2, 4, 8, 16, 32, 64 and 128 MPI processes
        for P in 1 2 4 8 16 32 64 128 256;
        do
            echo " >> Running with $P MPI Processes..."
            
            # Run the MPI executable passing the CURRENT matrix path
            mpirun -np $P build/spmv_strong_exec "$matrix_path" "$BENCH_FILE"
        done
        
        echo " >> Completed processing matrix: $matrix_name."
        echo ""
    fi
done

echo ""
echo ">>> Strong Scaling Tests Completed."

# ======================================
# SUMMARY GENERATION
# ======================================
echo ""
echo "=========================================="
echo "  Benchmark Strong Scaling Complete!"
echo "=========================================="
echo "End time: $(date)"
echo "Results saved to: $BENCH_FILE"
echo ""
echo ">>> Generating system summary..."

LSCPU_OUTPUT=$(lscpu 2>/dev/null)
FREE_OUTPUT=$(free -h 2>/dev/null)
OS_VERSION=$(grep -E '^(NAME|VERSION)=' /etc/os-release | cut -d'"' -f2 | paste -sd " " -)
KERNEL_VERSION=$(uname -r)

# Helper function to parse system info
parse_cpu() {
    echo "$LSCPU_OUTPUT" | grep -i "$1" | awk -F ':' '{print $2}' | sed 's/^[ \t]*//' | head -n 1
}

# Trova interfaccia attiva (escludendo loopback)
ACTIVE_IF=$(ip -o link show up | grep -v "lo" | awk -F': ' '{print $2}' | head -n 1)

if [ -n "$ACTIVE_IF" ]; then
    # Leggi velocità e converti in Gbps
    RAW_SPEED=$(cat /sys/class/net/$ACTIVE_IF/speed 2>/dev/null)
    if [ -n "$RAW_SPEED" ]; then
        NET_SPEED="$((RAW_SPEED / 1000)) Gbps"
    else
        NET_SPEED="Unknown"
    fi
    
    # Cerca modello Broadcom/Mellanox (Hardware HPC)
    NET_MODEL=$(/sbin/lspci | grep -E -i "Broadcom|Mellanox" | cut -d: -f3- | sed 's/^[ \t]*//' | head -n 1)
    
    # Check RDMA (se il comando esiste)
    if command -v ibv_devinfo &> /dev/null; then
       RDMA_STATUS="Available (RoCE/IB Driver Active)"
    else
       RDMA_STATUS="Not Detected (TCP/IP only)"
    fi
else
    ACTIVE_IF="None"
    NET_SPEED="N/A"
    NET_MODEL="Unknown"
    RDMA_STATUS="N/A"
fi

# Crearte summary file
SUMMARY_FILE="logs/strong_scaling/strong_scaling_summary.txt"
{
    echo "============================================================"
    echo "  HPC BENCHMARK - SYSTEM & EXECUTION SUMMARY"
    echo "============================================================"
    echo "Date:             $(date)"
    echo "Hostname:         $(hostname)"
    echo "OS / Kernel:      $OS_VERSION ($KERNEL_VERSION)"
    echo ""
    echo "------------------------------------------------------------"
    echo "  COMPUTING RESOURCES (CPU/RAM)"
    echo "------------------------------------------------------------"
    echo "CPU Model:        $(parse_cpu "Model name")"
    echo "Architecture:     $(parse_cpu "Architecture")"
    echo "Total Sockets:    $(parse_cpu "^Socket(s):")"
    echo "Cores per Socket: $(parse_cpu "^Core(s) per socket:")"
    echo "Total Phys Cores: $(parse_cpu "^CPU(s):")"
    echo "L3 Cache:         $(parse_cpu "L3 cache")"
    echo "Total Memory:     $(echo "$FREE_OUTPUT" | grep 'Mem:' | awk '{print $2}')"
    echo ""
    echo "------------------------------------------------------------"
    echo "  INTERCONNECT TOPOLOGY (NETWORK)"
    echo "------------------------------------------------------------"
    echo "Active Interface: $ACTIVE_IF"
    echo "Link Speed:       $NET_SPEED"
    echo "Adapter Model:    $NET_MODEL"
    echo "Transport Proto:  $RDMA_STATUS"
    echo "Jumbo Frames:     $(ip link show $ACTIVE_IF | grep -o 'mtu [0-9]*' | awk '{print $2}')"
    echo ""
    echo "------------------------------------------------------------"
    echo "  SOFTWARE ENVIRONMENT"
    echo "------------------------------------------------------------"
    echo "GCC Version:      $(gcc --version | head -n 1)"
    echo "MPI Version:      $(mpirun --version | head -n 1)"
    echo ""
    echo "------------------------------------------------------------"
    echo "  OUTPUT FILES"
    echo "------------------------------------------------------------"
    echo "Data:             $BENCH_FILE"     
} > "$SUMMARY_FILE"

echo ">>> Summary saved to: $SUMMARY_FILE"