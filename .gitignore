# Ignore the CMake build folder
/build/

# Ignore cluster log and output files
/logs/*.log
/logs/*.err
/logs/*.out
!/logs/.gitkeep

# Ignore matrix files
/matrices/*.mtx

# Ignore results files (if you decide not to upload them)
# Comment out this line if you WANT to upload .csv files
# /results/*.csv

# Ignore the final executable
# (Put the name of your executable)
spmv_benchmark

# Ignore object files and libraries
*.o
*.a
*.so

# Ignore macOS system files
.DS_Store

# Ignore VS Code files
.vscode/

